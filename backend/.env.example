# MySQL local (XAMPP: usuario root sin contraseña)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cedros_previene
# En la nube (Aiven) cambie a true
DB_SSL=false

# Seguridad
JWT_SECRET=cambie-esta-clave-por-una-larga-y-secreta
JWT_EXPIRES=8h
# Contraseña inicial de los usuarios de prueba creados al arrancar
SEED_PASSWORD=Cedros2026!

# Servicio de ML (FastAPI)
ML_URL=http://localhost:8000
ML_API_KEY=
# Si el servicio de ML está apagado, usar el modelo provisional del Sprint 1 (true/false)
ML_FALLBACK=true
